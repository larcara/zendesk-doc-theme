<div class="container">
  <div class="sub-nav">
    {{breadcrumbs}}
  </div>

  <header class="page-header">
    <h1>{{t 'new_post'}}</h1>
  </header>

  <div class="form">
    {{#form 'post' class='new-post-form'}}
      <div class="form-field">
        {{label 'title'}}
        {{input 'title' autofocus=true}}
      </div>
      <div class="form-field">
        {{label 'details'}}
        {{wysiwyg 'details'}}
      </div>
      <div class="form-field">
        {{label 'topic'}}
        {{select 'topic'}}
      </div>
      <footer>
        {{input type='submit' class='btn btn-primary'}}
      </footer>
    {{/form}}
  </div>
</div>
