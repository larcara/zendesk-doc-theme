<div class="container">
  <header class="page-header">
    <h1>
      {{#if query}}
        {{t 'search_results_for' query=query}}
      {{else}}
        {{t 'search'}}
      {{/if}}
    </h1>
  </header>

  {{search submit=false class='search'}}

  {{#if results}}
  <ul class="search-results-list">
    {{#each results}}
    <li class="search-result">
      <a href="{{url}}">
        <h2 class="search-result-title">{{title}}</h2>
        <p class="search-result-snippet">{{text}}</p>
      </a>
    </li>
    {{/each}}
  </ul>

  {{pagination}}
  {{else}}
    {{#if query}}
      <p class="no-results">{{t 'no_results' query=query}}</p>
    {{/if}}
  {{/if}}
</div>
