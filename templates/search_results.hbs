<div class="container">
  <header class="page-header">
    <h1>
      {{#if query}}
        {{t 'search_results_for' query=query}}
      {{else}}
        {{t 'search'}}
      {{/if}}
    </h1>
  </header>

  <form role="search" class="search" action="{{search.url}}" data-instant="true">
    <input type="search" name="query" id="query" class="search-input" value="{{query}}" placeholder="{{t 'search_placeholder'}}" autocomplete="off" aria-label="{{t 'search'}}">
    <button type="submit" class="search-btn" aria-label="{{t 'search'}}">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
  </form>

  {{#if results}}
  <ul class="search-results-list">
    {{#each results}}
    <li class="search-result">
      <a href="{{url}}">
        <h2 class="search-result-title">{{title}}</h2>
        <p class="search-result-snippet">{{{snippet}}}</p>
      </a>
    </li>
    {{/each}}
  </ul>

  {{pagination}}
  {{else}}
    {{#if query}}
      <p class="no-results">{{t 'no_results' query=query}}</p>
    {{/if}}
  {{/if}}
</div>
