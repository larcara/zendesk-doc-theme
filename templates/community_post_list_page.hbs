<div class="container">
  <div class="sub-nav">
    {{breadcrumbs}}
  </div>

  <header class="page-header community-header">
    <h1>{{t 'community'}}</h1>
    <span class="post-to-community">
      {{link 'new_post' class='btn btn-primary'}}
    </span>
  </header>

  {{#if posts}}
  <ul class="post-list">
    {{#each posts}}
    <li class="post-list-item">
      <a href="{{url}}">
        <h2 class="post-title">{{title}}</h2>
        <div class="post-meta">
          <span class="post-author">{{author.name}}</span>
          <time datetime="{{created_at}}">{{date created_at}}</time>
          <span class="post-comments-count">{{comment_count}} {{t 'comments'}}</span>
        </div>
      </a>
    </li>
    {{/each}}
  </ul>

  {{pagination}}
  {{else}}
    <p class="no-results">{{t 'no_posts'}}</p>
  {{/if}}
</div>
