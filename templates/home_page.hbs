<h1 class="visibility-hidden">{{ help_center.name }}</h1>

<section id="main-content" class="home-hero">
  <div class="container home-hero__inner">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">Carbonio Support Portal</p>

      <h2 class="home-hero__title">
        How can we help you today?
      </h2>

      <p class="home-hero__subtitle">
        Search technical documentation, troubleshooting guides and product resources.
      </p>
	 <div class="home-hero__search-wrapper">
    <svg xmlns="http://www.w3.org/2000/svg"
         width="16"
         height="16"
         viewBox="0 0 16 16"
         class="search-icon"
         aria-hidden="true">
      <circle cx="6.5" cy="6.5" r="5" fill="none" stroke="currentColor"/>
      <path stroke="currentColor" stroke-linecap="round" d="M15 15L11 11"/>
    </svg>

    {{search submit=false instant=settings.instant_search class='search search-full'}}
  </div>
</div>
      <div class="home-hero__quick-links" aria-label="Quick actions">
  <a href="/hc/en-gb/categories/21625721231388-Announcements-Release-Notes" class="home-hero__quick-link">
    Announcements & Release Notes
  </a>
  <a href="/hc/en-gb/categories/21625675640476-Tools-Processes-and-Resources" class="home-hero__quick-link">
    Tools, Processes & Resources
  </a>
  <a href="/hc/en-gb/categories/21625675640476-Tools-Processes-and-Resources" class="home-hero__quick-link">
    Early Access
  </a>
</div>
    </div>
</section>
<br>
<div class="container">
  {{#if promoted_articles}}
  <section class="articles home-section home-section--featured">
    <div class="home-section__header">
      <h2>Featured articles</h2>
      <p>Quick access to release notes, technical updates and frequently used support content.</p>
    </div>

    <ul class="article-list promoted-articles promoted-articles--list">
      {{#each promoted_articles}}
        <li class="promoted-articles-item">
          <a href="{{url}}" class="promoted-articles-link">
            <span class="promoted-articles-title">{{title}}</span>

            {{#if internal}}
              <span class="promoted-articles-meta">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16" class="icon-lock" aria-hidden="true">
                  <rect width="12" height="9" x="2" y="7" fill="currentColor" rx="1" ry="1"/>
                  <path fill="none" stroke="currentColor" d="M4.5 7.5V4a3.5 3.5 0 017 0v3.5"/>
                </svg>
                <span>{{t 'internal'}}</span>
              </span>
            {{/if}}
          </a>
        </li>
      {{/each}}
    </ul>
  </section>
{{/if}}
</div>
  
  <div class="container">
  <section class="section knowledge-base home-section home-section--categories">
  <div class="home-section__header">
    <h2>Browse resources</h2>
    <p>Start from the area that best matches the type of content you need.</p>
  </div>
  <section class="categories blocks">
    <ul class="blocks-list blocks-list--categories">
      {{#each categories}}
        {{#if ../has_multiple_categories}}
          <li class="blocks-item">
            <a href='{{url}}' class="blocks-item-link">
              <span class="blocks-item-title">{{name}}</span>
              {{#if description}}
                <span class="blocks-item-description">{{excerpt description}}</span>
              {{/if}}
            </a>
          </li>
        {{else}}
          {{#each sections}}
            <li class="blocks-item">
              <a href='{{url}}' class="blocks-item-link">
                <span class="blocks-item-title">{{name}}</span>
                {{#if description}}
                  <span class="blocks-item-description">{{excerpt description}}</span>
                {{/if}}
              </a>
            </li>
          {{/each}}
        {{/if}}
      {{/each}}
    </ul>
    {{pagination}}
  </section>


  {{#if help_center.community_enabled}}
    <section class="section home-section community">
      <h2>{{t 'community'}}</h2>
      {{#link 'community' class='community-link'}}
        {{t 'join_conversation'}}
      {{/link}}

      <div class="community-image"></div>
    </section>
  {{/if}}

  <section class="section home-section activity">
    {{#if settings.show_recent_activity}}
      {{recent_activity}}
    {{/if}}
  </section>
</div>
