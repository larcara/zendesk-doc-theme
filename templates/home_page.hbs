<div class="home-page">
  {{#if show_hero}}
  <div class="hero" {{#if homepage_hero}}style="background-image: url('{{homepage_hero}}')"{{/if}}>
    <div class="container">
      <h1 class="hero-title">{{t 'home_page_title' help_center_name=help_center.name}}</h1>
      <form role="search" class="search" action="{{search.url}}" data-instant="true">
        <input type="search" name="query" id="query" class="search-input" placeholder="{{t 'search_placeholder'}}" autocomplete="off" aria-label="{{t 'search'}}">
        <button type="submit" class="search-btn" aria-label="{{t 'search'}}">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    </div>
  </div>
  {{/if}}

  <div class="container">
    <section class="categories">
      {{#each categories}}
      <a href="{{url}}" class="category-card">
        <h2 class="category-title">{{name}}</h2>
        {{#if description}}
          <p class="category-description">{{description}}</p>
        {{/if}}
      </a>
      {{/each}}
    </section>

    {{#if promoted_articles}}
    <section class="promoted-articles">
      <h2>{{t 'promoted_articles'}}</h2>
      <ul class="article-list">
        {{#each promoted_articles}}
        <li><a href="{{url}}">{{title}}</a></li>
        {{/each}}
      </ul>
    </section>
    {{/if}}
  </div>
</div>
