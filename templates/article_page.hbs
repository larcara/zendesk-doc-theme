<div class="container-divider"></div>
<div class="container article-container">
  <div class="sub-nav">
    {{breadcrumbs}}
  </div>

  <div class="article-layout">
    <article class="article" id="main-content">
      <header class="article-header">
        <h1>{{article.title}}</h1>
        <div class="article-meta">
          <span class="article-author">{{article.author.name}}</span>
          <time datetime="{{article.edited_at}}" class="article-date">{{date article.edited_at}}</time>

        </div>
      </header>

      <div class="article-body">
        {{article.body}}
      </div>

      {{#if attachments}}
      <section class="article-attachments">
        <h2>{{t 'attachments'}}</h2>
        <ul>
          {{#each attachments}}
          <li>
            <a href="{{url}}" target="_blank" rel="noopener">{{name}} ({{size}})</a>
          </li>
          {{/each}}
        </ul>
      </section>
      {{/if}}

      <footer class="article-footer">
        <div class="article-vote" data-article-id="{{article.id}}">
          <span class="article-vote-question">{{t 'was_this_helpful'}}</span>
          <button class="article-vote-up" aria-label="{{t 'yes'}}">{{t 'yes'}}</button>
          <button class="article-vote-down" aria-label="{{t 'no'}}">{{t 'no'}}</button>
        </div>
      </footer>
    </article>

    <aside class="article-sidebar">
      <div class="sidebar-section">
        <h3>{{t 'need_help'}}</h3>
        <p>{{t 'need_help_desc'}}</p>
        <a href="{{help_center.url}}/requests/new" class="btn btn-primary btn-small">{{t 'submit_request'}}</a>
      </div>
    </aside>
  </div>

  {{#if article.comments_disabled}}{{else}}
  <section class="article-comments" id="comments">
    <h2>{{t 'comments'}}</h2>
    {{#each comments}}
    <div class="comment" id="comment-{{id}}">
      <div class="comment-header">
        <span class="comment-author">{{author.name}}</span>
        <time datetime="{{created_at}}">{{date created_at}}</time>
      </div>
      <div class="comment-body">{{body}}</div>
    </div>
    {{/each}}

    {{pagination}}

    {{#form 'comment' class='comment-form'}}
      {{wysiwyg 'body'}}
      {{input type='submit' class='btn btn-primary'}}
    {{/form}}
  </section>
  {{/if}}
</div>
