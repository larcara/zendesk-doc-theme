<nav class="breadcrumbs" aria-label="{{t 'breadcrumb'}}">
  <ol>
    <li><a href="{{help_center.url}}">{{help_center.name}}</a></li>
    <li aria-current="page">{{user.name}}</li>
  </ol>
</nav>

<div class="container">
  <header class="page-header profile-header">
    {{#if user.avatar_url}}
      <img src="{{user.avatar_url}}" alt="" class="profile-avatar">
    {{/if}}
    <h1>{{user.name}}</h1>
  </header>

  {{#if user.details}}
    <p class="profile-details">{{user.details}}</p>
  {{/if}}

  {{#if user_comments}}
  <section class="profile-activity">
    <h2>{{t 'recent_activity'}}</h2>
    <ul class="article-list">
      {{#each user_comments}}
      <li class="article-list-item">
        <a href="{{url}}">{{body}}</a>
        <time datetime="{{created_at}}">{{date created_at}}</time>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
</div>
