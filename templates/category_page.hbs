<nav class="breadcrumbs" aria-label="{{t 'breadcrumb'}}">
  <ol>
    <li><a href="{{help_center.url}}">{{help_center.name}}</a></li>
    <li aria-current="page">{{category.name}}</li>
  </ol>
</nav>

<div class="container">
  <header class="page-header">
    <h1>{{category.name}}</h1>
    {{#if category.description}}
      <p class="page-description">{{category.description}}</p>
    {{/if}}
  </header>

  <section class="section-list">
    {{#each sections}}
    <div class="section-card">
      <h2><a href="{{url}}">{{name}}</a></h2>
      {{#if description}}
        <p>{{description}}</p>
      {{/if}}
      <span class="article-count">{{t 'articles_count' count=article_count}}</span>
    </div>
    {{/each}}
  </section>
</div>
