<nav class="breadcrumbs" aria-label="{{t 'breadcrumb'}}">
  <ol>
    <li><a href="{{help_center.url}}">{{help_center.name}}</a></li>
    <li aria-current="page">{{t 'contributions'}}</li>
  </ol>
</nav>

<div class="container">
  <header class="page-header">
    <h1>{{t 'contributions'}}</h1>
  </header>

  {{#if contributions}}
  <ul class="article-list">
    {{#each contributions}}
    <li class="article-list-item">
      <a href="{{url}}">
        <span class="article-title">{{title}}</span>
        <time datetime="{{created_at}}">{{date created_at}}</time>
      </a>
    </li>
    {{/each}}
  </ul>

  {{pagination}}
  {{else}}
    <p class="no-results">{{t 'no_contributions'}}</p>
  {{/if}}
</div>
