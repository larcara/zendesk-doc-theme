<div class="container">
  <div class="request-breadcrumbs">{{breadcrumbs}}</div>

  <h1 class="request-title">{{request.subject}}</h1>

  <div id="main-content" class="request-container">
    <section class="request-main">
      <div class="request-details">
        <dl>
          <dt>{{t 'requester'}}</dt>
          <dd>{{request.requester.name}}</dd>
          <dt>{{t 'created_at'}}</dt>
          <dd><time datetime="{{request.created_at}}">{{date request.created_at}}</time></dd>
          <dt>{{t 'last_activity'}}</dt>
          <dd><time datetime="{{request.updated_at}}">{{date request.updated_at}}</time></dd>
          <dt>{{t 'status'}}</dt>
          <dd><span class="request-status status-label status-label-{{request.status}}">{{request.status_name}}</span></dd>
        </dl>
      </div>

      <ul class="comment-list">
        {{#each comments}}
        <li id="{{anchor}}" class="comment">
          <div class="comment-wrapper">
            <div class="comment-info">
              <div class="comment-author">
                <span class="comment-author-name">{{author.name}}</span>
                <span class="meta-data">{{date created_at}}</span>
              </div>
              <section class="comment-body">{{body}}</section>
              {{#if attachments}}
              <ul class="comment-attachments">
                {{#each attachments}}
                <li><a href="{{url}}" target="_blank">{{name}} ({{size}})</a></li>
                {{/each}}
              </ul>
              {{/if}}
            </div>
          </div>
        </li>
        {{/each}}
      </ul>

      {{pagination}}

      {{#form 'comment' class='comment-form'}}
        {{wysiwyg 'body'}}
        <div class="comment-form-controls">
          {{input type='submit' class='btn btn-primary'}}
        </div>
      {{/form}}
    </section>
  </div>
</div>
