<div class="container">
  <div class="sub-nav">
    {{breadcrumbs}}
  </div>

  <article class="post" id="main-content">
    <header class="post-header">
      <h1>{{post.title}}</h1>
      <div class="post-meta">
        <span class="post-author">{{post.author.name}}</span>
        <time datetime="{{post.created_at}}">{{date post.created_at}}</time>
      </div>
    </header>

    <div class="post-body">
      {{post.details}}
    </div>

    <div class="post-vote">
      <button class="post-vote-up" aria-label="{{t 'vote_up'}}">&#9650;</button>
      <span class="post-vote-count">{{post.vote_sum}}</span>
      <button class="post-vote-down" aria-label="{{t 'vote_down'}}">&#9660;</button>
    </div>
  </article>

  <section class="post-comments" id="comments">
    <h2>{{t 'comments'}} ({{post.comment_count}})</h2>

    {{#each comments}}
    <div class="comment" id="comment-{{id}}">
      <div class="comment-header">
        <span class="comment-author">{{author.name}}</span>
        <time datetime="{{created_at}}">{{date created_at}}</time>
      </div>
      <div class="comment-body">{{body}}</div>
      <div class="comment-vote">
        <button class="comment-vote-up" aria-label="{{t 'vote_up'}}">&#9650;</button>
        <span class="comment-vote-count">{{vote_sum}}</span>
        <button class="comment-vote-down" aria-label="{{t 'vote_down'}}">&#9660;</button>
      </div>
    </div>
    {{/each}}

    {{pagination}}

    {{#form 'comment' class='comment-form'}}
      {{wysiwyg 'body'}}
      {{input type='submit' class='btn btn-primary'}}
    {{/form}}
  </section>
</div>
